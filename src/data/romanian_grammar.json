    "topic_ar": "جنس الأسماء في الرومانية (مذكر، مؤنث، محايد)",
    "topic_en": "Noun Genders in Romanian (Masculine, Feminine, Neuter)",
    "category": "nouns",
    "explanation_ar": "تتميز اللغة الرومانية بوجود 3 أجناس للأسماء: المذكر (Masculin)، المؤنث (Feminin)، والمحايد (Neutru - يكون مذكر في المفرد ومؤنث في الجمع).",
    "explanation_en": "Romanian nouns have 3 genders: Masculine, Feminine, and Neuter (singular masculine, plural feminine).",
    "rules": [
      {
        "gender": "Masculin (مذكر)",
        "singular_ro": "băiat / om / frate / profesor",
        "plural_ro": "băieți / oameni / frați / profesori",
        "rule_ar": "ينتهي عادة بحرف ساكن ويجمع بحرف (i)",
        "rule_en": "Usually ends in consonant, plural with -i"
      },
      {
        "gender": "Feminin (مؤنث)",
        "singular_ro": "fată / casă / școală / țară",
        "plural_ro": "fete / case / școli / țări",
        "rule_ar": "ينتهي بالحرف الخاص (ă) أو (a) ويجمع بحرف (e) أو (i)",
        "rule_en": "Ends in -ă or -a, plural with -e or -i"
      },
      {
        "gender": "Neutru (محايد)",
        "singular_ro": "scaun / drum / oraș / parcuri",
        "plural_ro": "scaune / drumuri / orașe / parcuri",
        "rule_ar": "مفرد مذكر وجمع مؤنث، يجمع بـ (e) أو (uri)",
        "rule_en": "Singular masculine, plural feminine (-e or -uri)"
      }
    ]
  },
